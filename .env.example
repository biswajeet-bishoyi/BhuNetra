# BhuNetra AI — environment template
# Copy to `.env` and adjust locally. NEVER commit a real `.env`.

# --- Extraction engine (Engine 1) -------------------------------------------
# Local Ollama server hosting the vision-language model. Nothing leaves the machine.
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_KEEP_ALIVE=15m

# Longest image edge in px before extraction. Guardrail for 6 GB VRAM — raising this
# improves small-print reading but can exhaust GPU memory on laptop-class cards.
EXTRACTION_MAX_EDGE=1280

# Seconds to wait for a read. The first request after boot includes model load time.
EXTRACTION_TIMEOUT=300

# Per-field confidence below which a field is routed to Revenue Officer verification
# and the document becomes NEEDS_REVIEW.
EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# --- Server -----------------------------------------------------------------
# Comma-separated client origins allowed by CORS. Do not use "*" in production.
CLIENT_ORIGIN=http://localhost:3000

# --- Auth (Phase 9) ---------------------------------------------------------
# Generate a real secret before any non-local deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-this-is-not-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# --- WhatsApp Business Cloud API (Task 15) -----------------------------------
# Obtain from: Meta Developer Console > WhatsApp > Business > Your App > API Setup
# Long-lived access token. Without this the /api/alerts/whatsapp/dispatch endpoint
# falls back to a mock receipt so the UI demo flow still works.
WHATSAPP_PHONE_ID=your_whatsapp_business_phone_id
WHATSAPP_API_TOKEN=your_whatsapp_business_access_token
